und in Purchasing Power, Not Nominal Money"},"is_retracted":false,"new_card_hash":"065efa189f63a4521d9130caa1f41527c0416f1170419bbb163a41909df27dd2","prev_card_hash":null,"prev_checksum":null,"schema_version":"cacg.v0","seq":0,"timestamp":"1970-01-01T00:00:00Z"}
