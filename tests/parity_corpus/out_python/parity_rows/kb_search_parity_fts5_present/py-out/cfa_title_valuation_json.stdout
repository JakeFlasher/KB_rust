[{"card_hash":"555fbec614e21ae4ae1875a3c90475d1af2f59b4028d33f1ea114cf96a9481c9","card_id":"relative-valuation-pricing-multiples","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/relative-valuation-pricing-multiples.md","reading_id":"05_Equity","score":2e-06,"summary":"Relative valuation prices an equity by applying a market multiple, such as the price-earnings ratio, drawn from comparable firms. Damodaran treats pricing multiples as a fast alternative to intrinsic discounted cash flow valuation.","tags":["valuation","relative-valuation","multiples","price-earnings"],"title":"Relative Valuation Using Pricing Multiples"},{"card_hash":"0dc9145f6a1853ef999cd1460c0afa3719c5f739dbea3bde0623596cd488c5f4","card_id":"intrinsic-valuation-discounted-cash-flows","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/intrinsic-valuation-discounted-cash-flows.md","reading_id":"05_Equity","score":2e-06,"summary":"Intrinsic valuation derives the value of an equity from the expected cash flows it generates, discounted at a rate that reflects their riskiness. Damodaran frames discounted cash flow valuation as the foundational approach for estimating the value of any asset.","tags":["valuation","discounted-cash-flow","intrinsic-value"],"title":"Intrinsic Valuation and Discounted Cash Flows"},{"card_hash":"7f3f221ff3969b956ca216be9fec26b050717002f9e356a9f4aa6770b2dff9ac","card_id":"measuring-earnings-from-financial-statements","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/measuring-earnings-from-financial-statements.md","reading_id":"05_Equity","score":1e-06,"summary":"Measuring an equity's earnings requires separating recurring operating income from extraordinary items, discontinued operations, and accounting changes. Damodaran stresses that clean earnings inputs are essential to reliable equity valuation.","tags":["earnings","financial-statements","operating-income"],"title":"Measuring Earnings from Financial Statements"},{"card_hash":"fb3c4f1fd08963d09afdd065b4fb511974a639637888bf538964811e91f7ea5c","card_id":"equity-risk-and-expected-return","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/equity-risk-and-expected-return.md","reading_id":"05_Equity","score":1e-06,"summary":"Equity risk is measured as the variance of actual returns around an expected return, and the cost of equity adds a risk premium for the portion of that risk investors cannot diversify away. The capital asset pricing model is the most widely used framework.","tags":["risk","cost-of-equity","capital-asset-pricing-model"],"title":"Equity Risk and Expected Return"}]
