[{"card_hash":"0dc9145f6a1853ef999cd1460c0afa3719c5f739dbea3bde0623596cd488c5f4","card_id":"intrinsic-valuation-discounted-cash-flows","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/intrinsic-valuation-discounted-cash-flows.md","reading_id":"05_Equity","score":0.0,"summary":"Intrinsic valuation derives the value of an equity from the expected cash flows it generates, discounted at a rate that reflects their riskiness. Damodaran frames discounted cash flow valuation as the foundational approach for estimating the value of any asset.","tags":["valuation","discounted-cash-flow","intrinsic-value"],"title":"Intrinsic Valuation and Discounted Cash Flows"},{"card_hash":"555fbec614e21ae4ae1875a3c90475d1af2f59b4028d33f1ea114cf96a9481c9","card_id":"relative-valuation-pricing-multiples","path":"tests/parity_corpus/cfa_first_bite/cards/05_Equity/relative-valuation-pricing-multiples.md","reading_id":"05_Equity","score":0.0,"summary":"Relative valuation prices an equity by applying a market multiple, such as the price-earnings ratio, drawn from comparable firms. Damodaran treats pricing multiples as a fast alternative to intrinsic discounted cash flow valuation.","tags":["valuation","relative-valuation","multiples","price-earnings"],"title":"Relative Valuation Using Pricing Multiples"}]
