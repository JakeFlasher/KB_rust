__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.venv/
build/
dist/
*.egg-info/
.coverage
htmlcov/
# Local-only ingest outputs by default. The `/out/*` pattern
# (anchored to the repo root) excludes every file in the root
# `out/` directory but lets us force-re-include specific files
# below; git's gitignore semantics require this shape because a
# fully excluded directory cannot have children un-ignored.
/out/*
# Crate-local `out/` test-artifact paths (e.g. the `kb verify`
# test journal at `crates/cacg-cli/out/lint_journal.jsonl`); the
# exact-path entries here don't shadow the root-level
# force-includes below.
crates/cacg-cli/out/
.cacg/
.demo/
# Force-include the committed B1 semantic cache + its provenance
# sidecar at the repository root. These are the AC-6 committed
# artifacts (~45 KB cache + provenance); the rebuild ceremony at
# `_research/20_b1_cache_provisioning.md` documents how to
# regenerate them deterministically.
!/out/semantic_cache.json
!/out/semantic_cache.provenance.json

# AC-10 (v0 release): force-track the small published-index artifacts + the Pdfium
# provenance record that live under the otherwise-ignored /out/ tree. The large
# chunks_manifest.json (~85 MB), the regenerated source_matrix.json, and the transient
# lint_journal.jsonl stay ignored — see `_research/30_v0_release_and_rebuild_recipe.md`
# for the rebuild recipe + intentionally-untracked disposition. Git cannot un-ignore a
# file whose parent dir is excluded, so re-include the dir, re-ignore its contents, then
# re-include the four files.
!/out/cfa/
/out/cfa/*
!/out/cfa/cards_manifest.json
!/out/cfa/summaries.json
!/out/cfa/INDEX.md
!/out/cfa/pdfium_provenance.json

# hkex deck: re-include chain under the otherwise-ignored /out/ tree (same shape as
# /out/cfa above). The HAND-AUTHORED source_matrix.json is committed (it is authoring
# input, not a regenerated artifact, so it must survive a clean checkout — unlike the
# cfa source_matrix which is regenerated). The large chunks_manifest.json, the merged
# sources_manifest.json, and the per-source ingest_per_source/ tree stay ignored and are
# regenerated by run_ingest_per_source.py + merge_hkex_manifests.py. AC-10 extends this
# chain with the published-index artifacts (cards_manifest/summaries/INDEX/pdfium_provenance).
!/out/hkex/
/out/hkex/*
!/out/hkex/source_matrix.json

# Avoid committing huge intermediate scratch files
*.tmp
# Local working-tree backup archive (multi-GB self-snapshot); never track.
/framework.tar.gz
*.tar.gz

# Large PDF payloads travel outside git. Use scripts/pdf-archive.py to create
# a path-preserving archive before committing a source-only repository.
*.pdf
*.PDF
/.pdf-archives/

# Local-only loop state (loop trackers, round summaries, contracts, skill artifacts)
.humanize*
.stress/
.stress.build.lock

# Per-card history-file POSIX flock sidecars (transient, zero-byte; do not track).
# Parity-test fixtures under tests/parity_corpus/ are NOT covered by this rule
# (they need to capture the Python oracle's exact lock-file behavior).
/cards/**/*.history.jsonl.lock
/out/**/*.lint_journal.jsonl.lock
/sources/cfa/_registry/release_baseline/*.lock

# Cargo build artifacts (Rust port workspace)
target/
**/*.rs.bk

# Parity-harness perf reports (runtime artifacts emitted by
# `cargo xtask parity`; each run writes a new JSON under the
# frozen timestamp, so they're not source-controlled).
perf-reports/

# Test side-effect: `kb_cli_surface::unimplemented_dispatcher_…`
# invokes `kb new reading_01 some-slug` against a CWD-relative
# `cards/` root, which now succeeds (kb new is native) and writes a
# real card on disk. Treat as a runtime artifact until QS-2 swaps
# the test to a still-unimplemented verb.
crates/cacg-cli/cards/

# hkex deck — private Xueqiu corpus (DEC-1 / AC-11: excerpts-only). One public
# author's scraped posts are NOT redistributed wholesale: the complete corpus
# (the ingest source), the author-attributed distillation index, and the raw
# per-batch dumps are LOCAL-ONLY. Only card-level verbatim quote EXCERPTS (inside
# card citations) and the research reports/JSON are committed. The rendered corpus
# PDF (`sources/hkex/pdfs/*.pdf`) is already covered by the global `*.pdf` rule.
/_research/xueqiu_goubujiao/corpus_complete.md
/_research/xueqiu_goubujiao/corpus_full.md
/_research/xueqiu_goubujiao/batches/
# Derived, regenerable, machine-local CJK font face extracted from the system
# Noto CJK `.ttc` for the deterministic renderer (recorded by SHA in the renderer
# provenance; rebuilt from /usr/share/fonts on a clean checkout).
/sources/hkex/_registry/_fonts/
# Raw downloaded HTML of the free HTML grounding sources (IRD/IFEC). Local-only snapshots
# of public pages — like the *.pdf snapshots they render into; the committed acquisition
# manifest (grounding_sources.json) + the .pdf.provenance.json pin them by SHA.
/sources/hkex/pdfs/*.source.html
